SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_anon_key
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
SUPABASE_SECRET_KEY=sua_secret_key
FRONTEND_URL=http://localhost:5173
PORT=5000
AUTH_CACHE_TTL_SECONDS=30

# ── iopoint (ponto eletrônico) ─────────────────────────────────────────────
# Token estático da empresa (header apiIopointToken). Obtenha na plataforma
# iopoint: Configurações → Empresa → Token API (precisa de gestor administrador).
# Vazio = integração desligada (a tela de Ponto mostra as abas iopoint só quando há token).
IOPOINT_API_TOKEN=
# Base da API (padrão já aponta para produção)
# IOPOINT_API_BASE=https://api.iopoint.com.br/api/customer/v2
# 1 = token de matriz agrega as filiais do grupo econômico nas leituras (padrão 1)
# IOPOINT_INCLUDE_BRANCHES=1
# CNPJ (só dígitos) para restringir a uma empresa específica do grupo (opcional)
# IOPOINT_COMPANY_NATIONAL_REGISTRY=
# FLASK_DEBUG=0  <- manter 0 (ou ausente) em produção; use 1 apenas em dev local

# ── Stripe (SaaS Billing) ──────────────────────────────────────────────────
# Obtenha em https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Obtenha em https://dashboard.stripe.com/webhooks após registrar o endpoint /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# URLs de retorno após checkout (opcionais — padrão usa FRONTEND_URL)
# STRIPE_SUCCESS_URL=https://seu-dominio.com/assinatura?checkout=success
# STRIPE_CANCEL_URL=https://seu-dominio.com/assinatura?checkout=cancel
